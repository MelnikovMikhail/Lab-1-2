using System;
using System.Text;

public class Program
{
    public static string SimpleAdd(string a, string b)
    {
        a = a.Trim();
        b = b.Trim();

        int i = a.Length - 1;
        int j = b.Length - 1;

        var sb = new StringBuilder(Math.Max(a.Length, b.Length) + 1);

        while (i >= 0 || j >= 0)
        {
            int da = i >= 0 ? a[i] - '0' : 0;
            int db = j >= 0 ? b[j] - '0' : 0;

            int digit = (da + db) % 10;
            sb.Append((char)('0' + digit));

            i--;
            j--;
        }

        char[] chars = sb.ToString().ToCharArray();
        Array.Reverse(chars);

        string result = new string(chars).TrimStart('0');
        return result.Length == 0 ? "0" : result;
    }

    public static void Main()
    {
        string kLine = Console.ReadLine();
        if (kLine == null) return;

        string a = Console.ReadLine();
        string b = Console.ReadLine();

        if (a == null || b == null) return;

        Console.WriteLine(SimpleAdd(a, b));
    }
}
